# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   copy .env.example .env      (Windows)
#   cp   .env.example .env      (Linux/macOS)
#
# Create a WRITE token at https://huggingface.co/settings/tokens and scope it to
# the checkpoint dataset only. If this value ever reaches a public repo, revoke
# it immediately and issue a new one -- a leaked write token lets anyone
# overwrite or delete the checkpoints.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the mirror target (defaults to the repo_id in the config).
# BUDWORM_HF_REPO=eyadgad/budworm-checkpoints

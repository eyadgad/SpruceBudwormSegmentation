{
  "data": {
    "root": "Data",
    "cleaned_subdir": "Cleaned_Date_2013_2019",
    "matched_csv": "matched_samples.csv",
    "artifacts_dir": "artifacts_night",
    "targets_dir": "artifacts/targets"
  },
  "split": {
    "mode": "night",
    "fractions": {
      "train": 0.7,
      "val": 0.2,
      "test": 0.1
    },
    "seed": 42
  },
  "channels": [
    "th_e0",
    "th_e1",
    "th_e2",
    "th_e3",
    "th_e4",
    "th_e5",
    "th_e6",
    "th_e7",
    "th_e8",
    "valid_mask"
  ],
  "target": {
    "mode": "threshold",
    "dbz_threshold": 0.0,
    "soft_sigma": 0.0
  },
  "negatives": {
    "include": true,
    "balanced": true,
    "ratio": 1.0
  },
  "patch": {
    "size": 256,
    "patches_per_image": 8,
    "pos_sample_rate": 0.5,
    "hard_pos_rate": 0.3
  },
  "train": {
    "epochs": 50,
    "batch_size": 8,
    "cls_batch_size": 4,
    "lr": 0.0001,
    "weight_decay": 0.0001,
    "warmup_epochs": 3,
    "patience": 999,
    "es_tolerance": 0.001,
    "amp": true,
    "amp_dtype": "bfloat16",
    "accum_steps": 1,
    "num_workers": 0,
    "pin_memory": false,
    "snapshot_every": 1,
    "scene_cache": 16,
    "seed": 42
  },
  "augment": {
    "enabled": true,
    "hflip": true,
    "vflip": true,
    "rot90": true
  },
  "eval": {
    "patch_size": 256,
    "overlap": 0.5,
    "tta": false,
    "gaussian_window": true,
    "boundary_metrics": true,
    "nsd_tolerance": 2.0,
    "threshold_range": [
      0.15,
      0.2,
      0.25,
      0.3,
      0.35,
      0.4,
      0.45,
      0.5,
      0.55,
      0.6
    ],
    "calib_max_scenes": 50,
    "defer_test": true
  },
  "model": {
    "name": "transunet",
    "img_size": 256
  },
  "loss": {
    "name": "focal_tversky",
    "alpha": 0.3,
    "beta": 0.7,
    "gamma": 1.333,
    "uncertainty_weight": true
  },
  "output_dir": "outputs/night_gated",
  "name": "transunet_night"
}
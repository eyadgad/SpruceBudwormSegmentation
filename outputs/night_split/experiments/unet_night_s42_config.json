{
  "data": {
    "root": "Data",
    "cleaned_subdir": "Cleaned_Date_2013_2019",
    "matched_csv": "matched_samples.csv",
    "artifacts_dir": "artifacts_night",
    "targets_dir": "artifacts/targets"
  },
  "split": {
    "mode": "night",
    "fractions": {
      "train": 0.7,
      "val": 0.2,
      "test": 0.1
    },
    "seed": 42
  },
  "channels": [
    "th_e0",
    "th_e1",
    "th_e2",
    "th_e3",
    "th_e4",
    "th_e5",
    "th_e6",
    "th_e7",
    "th_e8",
    "valid_mask"
  ],
  "target": {
    "mode": "threshold",
    "dbz_threshold": 0.0,
    "soft_sigma": 0.0
  },
  "negatives": {
    "include": true,
    "balanced": true,
    "ratio": 1.0
  },
  "patch": {
    "size": 256,
    "patches_per_image": 8,
    "pos_sample_rate": 0.5,
    "hard_pos_rate": 0.3
  },
  "train": {
    "epochs": 100,
    "batch_size": 8,
    "lr": 0.0003,
    "weight_decay": 1e-05,
    "warmup_epochs": 3,
    "patience": 50,
    "es_tolerance": 0.001,
    "amp": true,
    "amp_dtype": "bfloat16",
    "accum_steps": 1,
    "num_workers": 0,
    "pin_memory": false,
    "snapshot_every": 1,
    "scene_cache": 48,
    "seed": 42
  },
  "augment": {
    "enabled": true,
    "hflip": true,
    "vflip": true,
    "rot90": true
  },
  "eval": {
    "patch_size": 256,
    "overlap": 0.5,
    "tta": false,
    "gaussian_window": true,
    "boundary_metrics": true,
    "nsd_tolerance": 2.0,
    "nsd_taus_px": [
      1,
      2,
      3,
      4,
      6,
      8,
      10,
      14,
      20
    ],
    "bf1_sigma_px": 2.0,
    "far_min_area_km2": 25.0,
    "bootstrap": true,
    "threshold_range": [
      0.15,
      0.2,
      0.25,
      0.3,
      0.35,
      0.4,
      0.45,
      0.5,
      0.55,
      0.6
    ],
    "cls_threshold_range": [
      1e-06,
      2.2e-06,
      4.6e-06,
      1e-05,
      2.2e-05,
      4.6e-05,
      0.0001,
      0.00022,
      0.00046,
      0.001,
      0.0022,
      0.0046,
      0.01,
      0.022,
      0.046,
      0.1,
      0.22,
      0.46,
      0.9
    ],
    "cls_r_min": 0.98,
    "calib_max_scenes": 50,
    "gate": "off",
    "defer_test": true
  },
  "model": {
    "name": "unet",
    "base_filters": 32
  },
  "loss": {
    "name": "focal_tversky",
    "alpha": 0.3,
    "beta": 0.7,
    "gamma": 1.333
  },
  "output_dir": "outputs/night_split",
  "sync": {
    "enabled": true,
    "repo_id": "eyadgad/budworm-checkpoints",
    "every_epochs": 50,
    "push_resume": true
  },
  "data_prep": {
    "norm_max_scenes": 200,
    "norm_channels": [
      "th_e0",
      "th_e1",
      "th_e2",
      "th_e3",
      "th_e4",
      "th_e5",
      "th_e6",
      "th_e7",
      "th_e8",
      "th_e9",
      "height_e0",
      "dem",
      "bh_e0"
    ]
  },
  "name": "unet_night_s42"
}